<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Jellyfin 10.11.x runs on .NET 9 (10.10.x also used net8.0; 10.11 moved to net9.0) -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.ShowDirector</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.ShowDirector</RootNamespace>
    <Version>12.0.0.0</Version>
    <PackageIcon>logo.jpg</PackageIcon>

    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".\images\logo.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the config page and the JS payload directly into the plugin DLL -->
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\show-director.js" />
  </ItemGroup>

</Project>
